# ─────────────────────────────────────────────
# ADUASIS — .gitignore
# ─────────────────────────────────────────────

# ── .NET / C# ──────────────────────────────────
*.user
*.suo
*.userosscache
*.sln.docstates
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
.vs/
*.ncrunchproject
*.ncrunchsolution
_ReSharper*/
TestResult.xml
*.VisualState.xml
*.dotCover
BenchmarkDotNet.Artifacts/

# ── Variables de entorno y secretos ────────────
# NUNCA subir archivos con credenciales reales
appsettings.Development.json
appsettings.Production.json
.env
.env.local
.env.*.local
*.env

# ── Node.js / Frontend ─────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.cache/
.parcel-cache/
.next/
out/
build/

# ── Logs ───────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Cobertura de pruebas ───────────────────────
coverage/
*.lcov
.nyc_output/
TestResults/

# ── IDEs y editores ────────────────────────────
.idea/
*.swp
*.swo
*~
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-snippets

# ── Docker ─────────────────────────────────────
# (descomentar cuando se use Docker)
# .docker/
# docker-compose.override.yml

# ── Archivos del sistema operativo ─────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Blender y archivos 3D temporales ──────────
*.blend1
*.blend2
__pycache__/

# ── Certificados de desarrollo ─────────────────
*.pfx
*.p12
